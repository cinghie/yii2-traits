{
    "name": "cinghie/yii2-traits",
    "description": "Yii2 Traits",
    "keywords": [
        "yii2 traits",
        "yii2 traits library",
        "yii2 traits module",
        "yii2 traits modules"
    ],
    "type": "yii2-extension",
    "homepage": "http://github.com/cinghie/yii2-traits",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Gogodigital.it",
            "email": "info@gogodigital.it",
            "homepage": "http://www.gogodigital.it/"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "yiisoft/yii2": "~2.0.10",
        "2amigos/yii2-ckeditor-widget": "^2.1.0",
        "2amigos/yii2-taggable-behavior": "^1.0",
        "2amigos/yii2-tinymce-widget": "^1.1",
        "cinghie/yii2-user-extended": "dev-master",
        "cocur/slugify": "^3.2 || ^4.0",
        "dektrium/yii2-user": "dev-master",
        "james-heinrich/getid3": "^1.9.25",
        "kartik-v/yii2-detail-view": "^1.8.7",
        "kartik-v/yii2-helpers": "^1.3.9",
        "kartik-v/yii2-markdown": "^1.3.1",
        "kartik-v/yii2-mpdf": "^1.0.6",
        "kartik-v/yii2-social": "^1.3.5",
        "kartik-v/yii2-widgets": "^3.4.1",
        "php-ffmpeg/php-ffmpeg": "^0.19 || ^1.0",
        "vova07/yii2-imperavi-widget": "^2.0.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "google/cloud-translate": "Required only when using GoogleTranslateTrait; choose a release compatible with your PHP runtime."
    },
    "autoload": {
        "psr-4": {
            "cinghie\\traits\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "cinghie\\traits\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml --fail-on-warning"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
